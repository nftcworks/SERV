<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="ph.serv.marketplace" android:versionCode="12" android:versionName="1.0.11">
    <uses-sdk android:minSdkVersion="26" android:targetSdkVersion="35" />
    <application android:label="SERV" android:icon="@drawable/ic_serv"
        android:theme="@style/ServTheme" android:allowBackup="false"
        android:usesCleartextTraffic="false" android:enableOnBackInvokedCallback="false">
